TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
OWNER_CELL_PHONE=+15557654321
OPENAI_API_KEY=your_openai_api_key

# Live web research (Product Finder engine) - get a free key at https://serper.dev
SERPER_API_KEY=your_serper_api_key

# Shown on the dashboard hero banner
BUSINESS_NAME=Your Business

# Optional settings
OPENAI_MODEL=gpt-4o-mini

# --- Local development (SQLite) ---
# Leave DATABASE_URL empty locally and the app uses this SQLite file.
DATABASE_FILE=enterprise_leads.db

# --- Production (Postgres) ---
# When deployed, set DATABASE_URL to your hosted Postgres connection string.
# Render/Railway provide this automatically. Example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
